# ========================================================
# QuoteSys 通用商业报价系统环境变量配置模版
# ========================================================

# 运行环境: development | production
APP_ENV=development
APP_NAME=quote-service
PORT=8000

# 数据库配置 (PostgreSQL 唯一支持的引擎)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quotesys_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quotesys_db

# Redis 缓存配置 (商品目录高并发缓存、分布式原子单号自增)
REDIS_URL=redis://localhost:6379/0

# 安全配置 (生产环境务必更改为随机高强度字符串)
AUTH_SECRET=quotesys-production-auth-secret-key-replace-me
TOKEN_TTL_SECONDS=86400

# 文件与上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# 跨域配置
CORS_ORIGINS=*

# ===== AI 资料导入 Agent（可选：不配置接口地址+模型时走离线 Mock）=====
# LLM_PROVIDER=auto
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# 工具循环最大步数（profiler 节点自主选工具的模型调用上限）
# LLM_MAX_STEPS=20
# 成本计量：按百万 token 单价折算（留 0 表示只统计 token 不计价）
# LLM_INPUT_PRICE_PER_1M=0
# LLM_OUTPUT_PRICE_PER_1M=0
# LLM_PRICE_CURRENCY=CNY
