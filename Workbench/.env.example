# ===== 数据库（SQLAlchemy 双引擎）=====
# 开发默认：backend/data/app.db（相对 backend/ 目录，目录不存在时启动会自动创建）
DATABASE_URL=sqlite:///./data/app.db
# 开箱即用全新本地库（backend/ 根目录，无目录依赖）：
# DATABASE_URL=sqlite:///./app.db
# 切换到 PostgreSQL（生产）：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ===== 鉴权（本地开发默认密钥，生产务必修改）=====
AUTH_SECRET=hhz-workbench-local-secret
# TOKEN_TTL_SECONDS=43200

# ===== 上传目录（Workbench/uploads，已 gitignore）=====
UPLOAD_DIR=./uploads

# ===== 数据生成 Agent =====
# 源资料目录（开发默认 ../assets = 仓库根 HHZ/assets；打包 exe 时由 entry.py 指向 %APPDATA%\HHZ\assets）
# ASSETS_DIR=../assets
# AGENT_DEFAULT_MODE=apply

# LLM：不配置接口地址+模型时使用离线 Mock；auto 会自动切换 OpenAI 兼容接口。
# 本地模型（Ollama / LM Studio）可不填 LLM_API_KEY，例如
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5
# LLM_PROVIDER=auto
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_MAX_STEPS=20

# ===== 应用 =====
# DEBUG=true
# CORS_ORIGINS=*
