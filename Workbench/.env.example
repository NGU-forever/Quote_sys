# ===== 数据库（仅 PostgreSQL）=====
# 先启动 PostgreSQL：仓库根目录 docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://quotesys_user:quotesys_secret@localhost:5432/quotesys_db
# 使用自有 PostgreSQL 实例时：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ===== Redis 缓存与单号自增（不可用时自动降级为数据库当日序号）=====
# REDIS_URL=redis://localhost:6379/0

# ===== 鉴权（本地开发默认密钥，生产务必修改）=====
AUTH_SECRET=hhz-workbench-local-secret
# TOKEN_TTL_SECONDS=43200

# ===== 上传目录（Workbench/uploads，已 gitignore）=====
UPLOAD_DIR=./uploads

# ===== 数据生成 Agent =====
# 源资料目录（开发默认 ../assets = 仓库根 HHZ/assets；打包 exe 时由 entry.py 指向 %APPDATA%\HHZ\assets）
# ASSETS_DIR=../assets
# AGENT_DEFAULT_MODE=apply

# LLM：不配置接口地址+模型时使用离线 Mock；auto 会自动切换 OpenAI 兼容接口。
# 本地模型（Ollama / LM Studio）可不填 LLM_API_KEY，例如
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5
# LLM_PROVIDER=auto
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_MAX_STEPS=20

# ===== 应用 =====
# DEBUG=true
# CORS_ORIGINS=*
